# ============================================================
# X-Term .gitignore  (Tauri 2 + Vue 3 + pnpm + Rust, Windows)
# ============================================================

# ---- 依赖目录 ----
node_modules/
.pnpm-store/

# ---- 前端构建产物 ----
dist/
dist-ssr/
*.local

# ---- Vite / TypeScript 缓存 ----
.vite/
*.tsbuildinfo

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.sln.docstates

# ---- 操作系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================================
# Rust / Tauri 后端
# ============================================================

# ---- 编译产物（体积巨大，绝对不入库）----
src-tauri/target/
target/

# ---- Tauri 生成的 schema（构建时重新生成）----
src-tauri/gen/

# ---- Cargo 缓存 ----
**/*.rs.bk

# ============================================================
# 敏感 / 本地运行时数据（绝不能传到 GitHub）
# ============================================================

# ---- 加密的凭据保险库（含密码/私钥，最高敏感）----
*.enc
master.key
credentials.*
*.key

# ---- 本地 SQLite 数据库 ----
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# ---- 本地设置（可能含 AI API Key / token）----
settings.local.json
.env
.env.*
!.env.example

# ============================================================
# 打包 / 发布产物
# ============================================================
release/
*.msi
*.exe
*.app
*.dmg
*.deb
*.AppImage

# ============================================================
# TOS 发布（凭据与暂存产物，绝不入库）
# ============================================================

# ---- 发布暂存目录（publish.bat 生成的 update.json 等）----
publish/

# ---- TOS 凭据（AK/SK），由 scripts/publish.bat 读取 ----
tos.env
scripts/tos.env

# ============================================================
# 本地笔记 / 调试产物（只留本地，不推到 GitHub）
# ============================================================

# ---- 本地代码审查与随手笔记（含内部问题清单，不适合公开）----
ed.md
review.md
yh.md
out.md
notes.md

# ---- 调试会话产物（本地复现 UI 卡顿等问题的临时文件）----
.dbg/

# ---- 截图生成工具链（本地渲染用；产物 docs/screenshots/ 才入库）----
scripts/_shots/
screenshots-tmp/

# ============================================================
# 工具 / 临时文件
# ============================================================

# ---- 构建脚本目录（本地工具，不入库）----
scripts/

# ---- ZCode 本地工作区（plans 等本地状态）----
.zcode/

# ---- 临时文件 ----
*.tmp
*.bak
*.swp
*~
# ---- rustfmt 检查残留（临时输出）----
src-tauri/fmt*.txt